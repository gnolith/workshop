{
  "name": "@gnolith/workshop",
  "version": "0.5.0",
  "description": "Self-hosted Gnolith MCP and BFF executable.",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnolith/workshop.git"
  },
  "homepage": "https://github.com/gnolith/workshop#readme",
  "bugs": {
    "url": "https://github.com/gnolith/workshop/issues"
  },
  "author": "Gnolith contributors",
  "keywords": [
    "agents",
    "sqlite",
    "mcp",
    "research",
    "sparql"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "gnolith-workshop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./executable": {
      "types": "./dist/executable.d.ts",
      "import": "./dist/executable.js"
    },
    "./local-adapter": {
      "types": "./dist/local-adapter.d.ts",
      "import": "./dist/local-adapter.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "migrations",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/generate-operation-contract.mjs --check && tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check && npm run audit:check",
    "artifact:path": "node scripts/artifact-path.mjs",
    "artifact:prepare": "node scripts/prepare-artifact.mjs",
    "artifact:verify": "node scripts/verify-artifact.mjs",
    "audit:check": "npm audit --omit=dev --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test scripts",
    "pack:check": "npm pack --dry-run --json",
    "performance:check": "node scripts/performance-check.mjs",
    "parity:node-sqlite": "node scripts/node-sqlite-parity.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "readiness:check": "node scripts/readiness-check.mjs",
    "release:boundary-check": "node scripts/prepublish-check.mjs --verify-dry-run",
    "release:check": "node scripts/release-block.mjs && node scripts/release-check.mjs",
    "security:dev-check": "node scripts/dev-security-smoke.mjs && node scripts/audit-zero.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "candidate:prepare": "node scripts/prepare-candidate.mjs",
    "packed:process-check": "node scripts/packed-process-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@traqula/parser-sparql-1-1": "^1.1.8",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "@gnolith/diamond": ">=0.5.0-0 <0.6.0",
    "@gnolith/taproot": ">=0.5.0-0 <0.6.0"
  },
  "peerDependenciesMeta": {
    "@gnolith/diamond": {
      "optional": true
    },
    "@gnolith/taproot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gnolith/diamond": "file:../diamond/gnolith-diamond-0.5.0.tgz",
    "@gnolith/taproot": "file:../taproot-artifacts/gnolith-taproot-0.5.0.tgz",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.7.0",
    "miniflare": "^4.20260714.0",
    "prettier": "^3.9.5",
    "tar-stream": "^3.1.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.8",
    "sharp": "0.35.3"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "test": "test"
  }
}
