{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnolith.dev/schemas/workshop-config-v1.json",
  "title": "gnolith-workshop-config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "listener", "authentication", "adapterModule"],
  "properties": {
    "format": { "const": "gnolith-workshop-config-v1" },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "profile"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "profile": { "enum": ["container", "remote", "test"] }
      }
    },
    "authentication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "credentialStore"],
          "properties": {
            "profile": { "const": "local-bearer-v1" },
            "credentialStore": { "$ref": "#/$defs/protectedSelector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "issuer",
            "audience",
            "algorithms",
            "requiredScopes",
            "resource",
            "authorizationServers",
            "scopeCapabilityMap",
            "principalClaim",
            "workspaceClaim",
            "installationClaim",
            "credentialClaim",
            "maxClockSkewSeconds",
            "metadata"
          ],
          "properties": {
            "profile": { "const": "remote-oauth-v1" },
            "issuer": { "type": "string", "format": "uri" },
            "audience": { "type": "string", "minLength": 1 },
            "algorithms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "requiredScopes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "resource": { "type": "string", "format": "uri" },
            "authorizationServers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "format": "uri" }
            },
            "scopeCapabilityMap": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "principalClaim": { "type": "string", "minLength": 1 },
            "workspaceClaim": { "type": "string", "minLength": 1 },
            "installationClaim": { "type": "string", "minLength": 1 },
            "credentialClaim": { "type": "string", "minLength": 1 },
            "maxClockSkewSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "metadata": { "$ref": "#/$defs/protectedSelector" }
          }
        }
      ]
    },
    "adapterModule": { "type": "string", "minLength": 1 },
    "corsOrigins": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "apiPrefix": { "const": "/api/v1" },
    "assetMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "manifest", "root"],
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^/[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)*$",
          "not": {
            "pattern": "^/(?:mcp|health|api|\\.well-known)(?:/|$)"
          },
          "description": "Static UI mount. Use /app. Reserved service prefixes and / are rejected.",
          "examples": ["/app"]
        },
        "manifest": { "$ref": "#/$defs/protectedSelector" },
        "root": { "$ref": "#/$defs/protectedSelector" }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalMs", "timeoutMs"],
      "properties": {
        "intervalMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 86400000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "shutdownTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    }
  },
  "$defs": {
    "protectedSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["file", "inherited-descriptor", "environment-selector"]
        },
        "value": { "type": ["string", "integer"] }
      }
    }
  }
}
