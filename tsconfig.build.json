    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/index.ts",
    "src/client.ts",
    "src/protocol.ts",
    "src/mcp.ts",
    "src/server.ts",
